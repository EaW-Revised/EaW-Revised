# Installed-data tests use the same exit-77 skip convention as the inventory gates.
function(eawr_add_game_data_test)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "NAME;WORKING_DIRECTORY" "COMMAND")
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    list(POP_FRONT arg_COMMAND program)
    if(TARGET "${program}")
        set(program "$<TARGET_FILE:${program}>")
    endif()
    add_test(NAME "${arg_NAME}"
        COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/ci/run_game_data_test.py"
                "${program}" ${arg_COMMAND})
    set_tests_properties("${arg_NAME}" PROPERTIES LABELS game-data SKIP_RETURN_CODE 77)
    if(arg_WORKING_DIRECTORY)
        set_tests_properties("${arg_NAME}" PROPERTIES WORKING_DIRECTORY "${arg_WORKING_DIRECTORY}")
    endif()
endfunction()

# Run after all registrations, including tests added below eawr_label_tests().
function(eawr_check_game_data_tests directory)
    get_property(tests DIRECTORY "${directory}" PROPERTY TESTS)
    foreach(test IN LISTS tests)
        get_property(labels TEST "${test}" DIRECTORY "${directory}" PROPERTY LABELS)
        if("game-data" IN_LIST labels)
            get_property(skip_code TEST "${test}" DIRECTORY "${directory}" PROPERTY SKIP_RETURN_CODE)
            get_property(skip_regex TEST "${test}" DIRECTORY "${directory}" PROPERTY SKIP_REGULAR_EXPRESSION)
            if("${skip_code}" STREQUAL "" AND "${skip_regex}" STREQUAL "")
                message(FATAL_ERROR "game-data test ${test} has no skip property: set SKIP_RETURN_CODE or SKIP_REGULAR_EXPRESSION")
            endif()
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        eawr_check_game_data_tests("${child}")
    endforeach()
endfunction()
