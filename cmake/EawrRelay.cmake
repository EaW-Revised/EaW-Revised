include_guard(GLOBAL)
if(EAWR_SOURCE_INVENTORY)
    # Source inventories include this module without creating build targets.
    return()
endif()
option(EAWR_ENABLE_RELAY "Build the optional TLS introduction client and standalone server" OFF)
set(_eawr_relay_root "${CMAKE_CURRENT_LIST_DIR}/..")
include("${_eawr_relay_root}/src/net/relay_sources.cmake")
find_package(Threads REQUIRED)
if(NOT EAWR_ENABLE_RELAY)
    add_library(eawr_relay STATIC ${EAWR_RELAY_DISABLED_SOURCES})
    add_library(eawr::relay ALIAS eawr_relay)
    target_include_directories(eawr_relay PUBLIC "${_eawr_relay_root}/include")
    target_compile_definitions(eawr_relay PUBLIC EAWR_HAS_RELAY=0)
    target_link_libraries(eawr_relay PRIVATE Threads::Threads)
    target_compile_features(eawr_relay PUBLIC cxx_std_20)
    if(COMMAND eawr_target_project_warnings)
        eawr_target_project_warnings(eawr_relay)
    elseif(MSVC)
        target_compile_options(eawr_relay PRIVATE /W4 /WX /permissive- /EHsc)
    else()
        target_compile_options(eawr_relay PRIVATE -Wall -Wextra -Wpedantic -Werror)
    endif()
    return()
endif()
add_library(eawr_relay STATIC ${EAWR_RELAY_CLIENT_SOURCES} ${EAWR_RELAY_DISABLED_SOURCES})
add_library(eawr::relay ALIAS eawr_relay)
target_include_directories(eawr_relay PUBLIC "${_eawr_relay_root}/include")
target_compile_features(eawr_relay PUBLIC cxx_std_20)
if(COMMAND eawr_target_project_warnings)
    eawr_target_project_warnings(eawr_relay)
elseif(MSVC)
    target_compile_options(eawr_relay PRIVATE /W4 /WX /permissive- /EHsc)
else()
    target_compile_options(eawr_relay PRIVATE -Wall -Wextra -Wpedantic -Werror)
endif()
find_package(Threads REQUIRED)
target_compile_definitions(eawr_relay PUBLIC EAWR_HAS_RELAY=1)
target_sources(eawr_relay PRIVATE ${EAWR_RELAY_TLS_SOURCES})
target_link_libraries(eawr_relay PRIVATE Threads::Threads)
if(WIN32)
    enable_language(C)
    include(FetchContent)
    # Official complete release; the published checksum matches this pin.
    # Static libraries inherit the caller's CRT choice. No OpenSSL install or
    # Mbed TLS DLL is needed on a build host or an end user's Windows machine.
    set(ENABLE_PROGRAMS OFF CACHE BOOL "" FORCE)
    set(ENABLE_TESTING OFF CACHE BOOL "" FORCE)
    set(MBEDTLS_FATAL_WARNINGS OFF CACHE BOOL "" FORCE)
    set(GEN_FILES OFF CACHE BOOL "" FORCE)
    set(DISABLE_PACKAGE_CONFIG_AND_INSTALL ON CACHE BOOL "" FORCE)
    FetchContent_Declare(eawr_mbedtls
        URL https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-3.6.7/mbedtls-3.6.7.tar.bz2
        URL_HASH SHA256=a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6
        DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(eawr_mbedtls)
    target_include_directories(eawr_relay SYSTEM PRIVATE "${eawr_mbedtls_SOURCE_DIR}/include")
    target_link_libraries(eawr_relay PRIVATE mbedtls mbedx509 mbedcrypto ws2_32 bcrypt advapi32 crypt32)
else()
    find_package(OpenSSL 1.1.1 REQUIRED COMPONENTS SSL Crypto)
    target_link_libraries(eawr_relay PRIVATE OpenSSL::SSL OpenSSL::Crypto)
endif()
