# Run by the custom command of EawrFactsCodeId.cmake: -DLIST_FILE=<file of paths, one per line> -DOUT=<generated .cpp>.
file(STRINGS "${LIST_FILE}" FACTS_CODE_FILES)
set(digests "")
foreach(path IN LISTS FACTS_CODE_FILES)
    file(SHA256 "${path}" digest)
    string(APPEND digests "${digest}|")
endforeach()
string(SHA256 code_id "${digests}")
string(SUBSTRING "${code_id}" 0 16 code_id)
# Always written, so the output is newer than the files it hashes and the command does not run again until one changes.
file(WRITE "${OUT}" "// Generated by cmake/EawrFactsCodeId.cmake: do not edit.\nnamespace eawr::platform {\nconst char* model_facts_code_id();\nconst char* model_facts_code_id() { return \"${code_id}\"; }\n} // namespace eawr::platform\n")
