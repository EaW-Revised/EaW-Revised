set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_C_COMPILER /opt/llvm/bin/clang-cl)
set(CMAKE_CXX_COMPILER /opt/llvm/bin/clang-cl)
set(CMAKE_LINKER /opt/llvm/bin/lld-link)
set(CMAKE_AR /opt/llvm/bin/llvm-lib)
set(CMAKE_RC_COMPILER /opt/llvm/bin/llvm-rc)
set(CMAKE_MT /opt/llvm/bin/llvm-mt)
set(CMAKE_FIND_ROOT_PATH /opt/xwin)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(_xwin_includes "/imsvc/opt/xwin/crt/include /imsvc/opt/xwin/sdk/include/ucrt /imsvc/opt/xwin/sdk/include/um /imsvc/opt/xwin/sdk/include/shared /imsvc/opt/xwin/sdk/include/winrt /imsvc/opt/xwin/sdk/include/cppwinrt")
set(CMAKE_C_FLAGS_INIT "${_xwin_includes}")
set(CMAKE_CXX_FLAGS_INIT "${_xwin_includes}")
set(CMAKE_RC_FLAGS_INIT "-I /opt/xwin/sdk/include/um -I /opt/xwin/sdk/include/shared -I /opt/xwin/sdk/include/ucrt")
# A case-sensitive host must resolve the mixed-case pragma in SDK headers.
set(_xwin_sdk_alias_dir "${CMAKE_BINARY_DIR}/xwin-sdk-aliases")
file(MAKE_DIRECTORY "${_xwin_sdk_alias_dir}")
if(NOT EXISTS "${_xwin_sdk_alias_dir}/Advapi32.lib")
    file(CREATE_LINK "/opt/xwin/sdk/lib/um/x86_64/AdvAPI32.Lib"
        "${_xwin_sdk_alias_dir}/Advapi32.lib" SYMBOLIC RESULT _xwin_alias_error)
    if(_xwin_alias_error)
        message(FATAL_ERROR "Cannot create xwin SDK library alias: ${_xwin_alias_error}")
    endif()
endif()
set(_xwin_libs "/libpath:${_xwin_sdk_alias_dir} /libpath:/opt/xwin/crt/lib/x86_64 /libpath:/opt/xwin/sdk/lib/um/x86_64 /libpath:/opt/xwin/sdk/lib/ucrt/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_xwin_libs}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_xwin_libs}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_xwin_libs}")
