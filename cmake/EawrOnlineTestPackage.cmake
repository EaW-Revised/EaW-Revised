# cmake -P script: stages the online test kit and zips it.
# Inputs: EXE, DLLS (list), PACKAGE_DIR (source files), OUT_DIR, ADDRESS, PORT, TRUST.
foreach(_name EXE PACKAGE_DIR OUT_DIR ADDRESS PORT TRUST)
    if(NOT DEFINED ${_name} OR "${${_name}}" STREQUAL "")
        message(FATAL_ERROR "EawrOnlineTestPackage: ${_name} is required")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/EawrOnlineTestConfig.cmake")
eawr_validate_online_test_config("${ADDRESS}" "${PORT}" "${TRUST}")
set(_stage "${OUT_DIR}/EAWR-online-test")
file(REMOVE_RECURSE "${_stage}" "${OUT_DIR}/EAWR-online-test.zip")
file(MAKE_DIRECTORY "${_stage}")
file(COPY "${EXE}" DESTINATION "${_stage}")
foreach(_dll IN LISTS DLLS)
    if(_dll STREQUAL "")
        continue()
    endif()
    file(COPY "${_dll}" DESTINATION "${_stage}")
endforeach()
file(COPY "${PACKAGE_DIR}/EAWR-online-test-host.cmd" "${PACKAGE_DIR}/EAWR-online-test-join.cmd" DESTINATION "${_stage}")
set(EAWR_ONLINE_TEST_ADDRESS "${ADDRESS}")
set(EAWR_ONLINE_TEST_PORT "${PORT}")
set(EAWR_ONLINE_TEST_TRUST "${TRUST}")
configure_file("${PACKAGE_DIR}/server.conf.in" "${_stage}/server.conf" @ONLY)
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUT_DIR}/EAWR-online-test.zip" --format=zip -- EAWR-online-test
    WORKING_DIRECTORY "${OUT_DIR}" RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "EawrOnlineTestPackage: zip failed (${_result})")
endif()
message(STATUS "online test kit: ${OUT_DIR}/EAWR-online-test.zip")
