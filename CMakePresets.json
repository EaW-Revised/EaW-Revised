        { "type": "build", "name": "linux-x64-clang" },
        { "type": "test", "name": "linux-x64-clang" }
      ]
    },
    {
      "name": "linux-arm64-gcc",
      "steps": [
        { "type": "configure", "name": "linux-arm64-gcc" },
        { "type": "build", "name": "linux-arm64-gcc" },
