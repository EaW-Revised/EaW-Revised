  "workflowPresets": [
    {
      "name": "windows-msvc",
      "steps": [
        { "type": "configure", "name": "windows-msvc" },
        { "type": "build", "name": "windows-msvc" },
        { "type": "test", "name": "windows-msvc" }
      ]
    },
    {
      "name": "windows-clang",
      "steps": [
        { "type": "configure", "name": "windows-clang" },
        { "type": "build", "name": "windows-clang" },
        { "type": "test", "name": "windows-clang" }
      ]
