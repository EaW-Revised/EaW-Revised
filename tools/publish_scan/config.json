{
  "_comment": "Rules of tools/publish_scan/publish_scan.py: what no commit of the public tree may contain. A new image or binary file is added here with its reason after review.",
  "security": {
    "regex": {
      "private-ipv4": "(?<![\\d.])(?:10(?:\\.(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)){3}|192\\.168(?:\\.(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)){2}|172\\.(?:1[6-9]|2\\d|3[01])(?:\\.(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)){2})(?![\\d.]*\\d)",
      "user-path": "(?i)\\b[a-z]:[\\\\/]+users[\\\\/]+(?!public\\b|default\\b|runneradmin\\b|<|%|\\$|\\{)[a-z0-9._-]+",
      "home-path": "/home/(?!runner\\b|user\\b|<|\\$)[a-z0-9._-]+",
      "binary-address": "\\b0x14[0-9A-Fa-f]{7}\\b",
      "decompiler-name": "\\b(?:FUN|DAT|LAB|PTR|thunk_FUN)_[0-9a-fA-F]{6,}\\b",
      "lan-host": "\\b[\\w-]+\\.lan\\b",
      "ssh-key-name": "\\bid_(?:ed25519|rsa|ecdsa)_\\w+"
    },
    "allow": [
      {
        "path": "third_party/lua/doc/manual.html",
        "regex": "/home/roberto",
        "reason": "upstream Lua manual example path"
      },
      {
        "path": "tests/assets/test_mtd_inventory.py",
        "regex": "PRIVATE|/home/private",
        "reason": "a made-up private path the test proves is never echoed"
      },
      {
        "path": "tests/scene/test_scene_inventory.py",
        "regex": "PrivateUser",
        "reason": "a made-up private path the test proves is never echoed"
      },
      {
        "path": "tools/publish_scan/config.json",
        "regex": "\"regex\": ",
        "reason": "this file's own allow rules quote the made-up paths they allow"
      }
    ]
  },
  "cleanroom": {
    "skip": [
      "third_party/",
      "tools/cleanroom_check.py"
    ]
  },
  "assets": {
    "retail_suffixes": [
