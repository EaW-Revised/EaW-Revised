  ],
  "timing": {
    "note": "load = top level of a script in the closure; start = a function reachable from load or from a start function through direct calls and Create_Thread literals; everything else is event or per-tick work (recurring) unless a rule below says otherwise.",
    "top_level": "load",
    "rules": [
      {
        "function": "^(Evaluate|Execute|Service|Update|Tick|On_|Story_Handle|Handle)",
        "timing": "recurring"
      }
    ],
    "default": "recurring",
    "start_functions": [
      "Definitions",
      "Base_Definitions",
      "Story_Mode_Definitions",
      "Begin",
      "Init",
      "Initialize"
    ]
  },
  "severity": {
    "note": "critical: runs at load/start in a script of a galactic host; high: recurring in one; medium: ground-battle-only or unresolved timing; low: standard-library partials.",
    "load": "critical",
    "start": "critical",
    "recurring": "high",
    "rare": "medium"
  },
  "object_modes": {
    "note": "How a GameObject script is assigned to a host: by the XML elements that name it in Lua_Script. First matching rule wins; none = unclassified (reported under the galactic object host as 'uncertain').",
    "galactic_tags": [
      "Planet",
      "SpecialStructure",
      "TradeRoute",
      "UpgradeObject",
      "StarBase",
      "Galactic_Fleet",
      "GalacticFleet",
      "Fleet"
    ],
    "space_tags": [
      "SpaceUnit",
      "SpaceProp",
      "SpaceBuildable",
      "SpaceStructure"
    ],
    "ground_tags": [
      "GroundCompany",
      "GroundInfantry",
      "GroundVehicle",
      "GroundStructure",
      "GroundBase",
      "HeroCompany",
      "GroundBuildable"
    ],
    "galactic_child_tags": [
