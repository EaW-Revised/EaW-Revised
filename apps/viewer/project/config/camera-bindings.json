{
  "schema": "eawr-camera-bindings",
  "version": 2,
  "provenance": "project-authored",
  "notice": "NON-RETAIL project-authored development bindings and free-camera settings for the EmpireAtWar-Revised viewer (issue #30). These are not the original Empire at War defaults; retail bindings, input cadence, map bounds and any free-flight speed or look sensitivity are unestablished and must not be inferred from this file.",
  "edge_scroll": true,
  "free_camera": {
    "move_speed": 600.0,
    "vertical_speed": 400.0,
    "look_degrees_per_unit": 0.2,
    "pitch_min_degrees": -85.0,
    "pitch_max_degrees": 85.0
  },
