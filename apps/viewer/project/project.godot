; Production P1 viewer bootstrap. Godot owns window/device/swapchain lifecycle.
config_version=5

[application]
config/name="EAWR Viewer"
run/main_scene="res://main.tscn"

[debug]
file_logging/max_log_files=30

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[display/window]
; ST-V1: retail defaults to off; saved player settings may enable it.
vsync/vsync_mode=0

[rendering]
; #4681/#4645: RaW 60 ships per side needs 262144 to avoid instance-uniform allocation errors.
limits/global_shader_variables/buffer_size=262144
; Separate render thread (2) is the default (needs the patched engine, third_party/godot/README.md).
; Opt out per run with the engine flag `--render-thread safe` (launcher: --safe-render-thread).
driver/threads/thread_model=2
renderer/rendering_method="forward_plus"
rendering_device/driver.windows="vulkan"
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
textures/default_filters/use_nearest_mipmap_filter=false

[eawr]
; WGS-97: observed save profile. Configurable independently from camera bindings.
input/quick_save="F6"
input/quick_load="F5"
