; Production P1 viewer bootstrap. Godot owns window/device/swapchain lifecycle.
config_version=5

[application]
config/name="EAWR Viewer"
run/main_scene="res://main.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[accessibility]
; Disabled (2) on purpose. With the engine's accessibility bridge active, Windows flags the idle game window
; "not responding" after about 30 s although it answers messages (the launcher's watchdog found this).
; Trade-off: the in-game UI has no screen-reader support today, so nothing is lost. Auto (0) would still turn the
; bridge on whenever any UI Automation client is present (that is how the false flag was hit), so Auto is not
; an option until the UI supports it. The launcher project is unaffected.
general/accessibility_support=2

[debug]
file_logging/max_log_files=30

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[display/window]
; ST-V1: retail defaults to off; saved player settings may enable it.
vsync/vsync_mode=0

[rendering]
; Each geometry instance reserves 16 vec4 slots, even with only one instance uniform.
; 20 MiB holds 81920 instance blocks; keep the slot count aligned to 1024-slot upload regions.
limits/global_shader_variables/buffer_size=1310720
; Separate render thread (2) is the default (needs the patched engine, third_party/godot/README.md).
; Opt out per run with the engine flag `--render-thread safe` (launcher: --safe-render-thread).
driver/threads/thread_model=2
; Depth pre-pass (engine default on). Startup-only; override per run with `--eawr-depth-prepass on|off` after `--`.
driver/depth_prepass/enable=true
renderer/rendering_method="forward_plus"
rendering_device/driver.windows="vulkan"
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
textures/default_filters/use_nearest_mipmap_filter=false

[eawr]
; WGS-97: observed save profile. Configurable independently from camera bindings.
input/quick_save="F6"
input/quick_load="F5"
