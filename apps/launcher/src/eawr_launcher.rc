#include <winres.h>

// RT_MANIFEST (24), resource id 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID; the linker's own manifest is off.
1 24 "eawr_launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,6,0
 PRODUCTVERSION 0,2,6,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EaW Revised"
            VALUE "FileDescription", "Empire at War Revised launcher"
            VALUE "FileVersion", "0.2.6.0"
            VALUE "InternalName", "EAWR"
            VALUE "OriginalFilename", "EAWR.exe"
            VALUE "ProductName", "Empire at War Revised"
            VALUE "ProductVersion", "0.2.6.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
