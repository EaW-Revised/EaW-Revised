# Area cases keep their own translation units and run one per CTest process.
# Ordinary eawr_add_test_case fragments remain supported for independent cases.
function(eawr_add_galactic_area_case)
    cmake_parse_arguments(PARSE_ARGV 0 arg "NO_ARGS;CONST_ARGV" "AREA;NAME" "SOURCES;LIBS;INCLUDE_DIRS;TESTS")
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES OR NOT arg_AREA OR NOT arg_NAME OR NOT arg_SOURCES)
        message(FATAL_ERROR "galactic area cases require AREA, NAME and SOURCES")
    endif()

    set(libs ${arg_LIBS})
    list(SORT libs)
    set(includes ${arg_INCLUDE_DIRS})
    list(SORT includes)
    if(NOT TARGET ${arg_AREA})
        set(options)
        if(arg_LIBS)
            list(APPEND options LIBS ${arg_LIBS})
        endif()
        if(arg_INCLUDE_DIRS)
            list(APPEND options INCLUDE_DIRS ${arg_INCLUDE_DIRS})
        endif()
        eawr_add_test_case(NAME ${arg_AREA}
            SOURCES "${CMAKE_CURRENT_BINARY_DIR}/${arg_AREA}_main.cpp" ${arg_SOURCES}
            ${options})
        set_property(TARGET ${arg_AREA} PROPERTY EAWR_AREA_LIBS "${libs}")
        set_property(TARGET ${arg_AREA} PROPERTY EAWR_AREA_INCLUDES "${includes}")
        set_property(DIRECTORY APPEND PROPERTY EAWR_GALACTIC_AREAS ${arg_AREA})
    else()
        get_property(area_libs TARGET ${arg_AREA} PROPERTY EAWR_AREA_LIBS)
        get_property(area_includes TARGET ${arg_AREA} PROPERTY EAWR_AREA_INCLUDES)
        if(NOT "${libs}" STREQUAL "${area_libs}" OR NOT "${includes}" STREQUAL "${area_includes}")
            message(FATAL_ERROR "${arg_NAME} has incompatible area links or includes: ${arg_AREA}")
        endif()
        target_sources(${arg_AREA} PRIVATE ${arg_SOURCES})
    endif()

    if(arg_NO_ARGS)
        set(parameters "")
        set(arguments "")
    elseif(arg_CONST_ARGV)
        # Preserve array spelling: MSVC decorates the adjusted pointer differently.
        set(parameters "int, const char* const[]")
        set(arguments "argc - 1, argv + 1")
    else()
        set(parameters "int, char**")
        set(arguments "argc - 1, argv + 1")
    endif()
    set_property(TARGET ${arg_AREA} APPEND_STRING PROPERTY EAWR_AREA_DECLARATIONS
        "int case_${arg_NAME}(${parameters});\n")
    set_property(TARGET ${arg_AREA} APPEND_STRING PROPERTY EAWR_AREA_DISPATCH
        "    if (name == \"${arg_NAME}\") return case_${arg_NAME}(${arguments});\n")
    foreach(test IN LISTS arg_TESTS)
        add_test(NAME ${test} COMMAND ${arg_AREA} ${arg_NAME})
    endforeach()
endfunction()

function(eawr_finish_galactic_areas)
    get_property(areas DIRECTORY PROPERTY EAWR_GALACTIC_AREAS)
    foreach(area IN LISTS areas)
        get_property(DECLARATIONS TARGET ${area} PROPERTY EAWR_AREA_DECLARATIONS)
        get_property(DISPATCH TARGET ${area} PROPERTY EAWR_AREA_DISPATCH)
        configure_file("${CMAKE_CURRENT_SOURCE_DIR}/area_main.cpp.in"
            "${CMAKE_CURRENT_BINARY_DIR}/${area}_main.cpp" @ONLY)
    endforeach()
endfunction()
