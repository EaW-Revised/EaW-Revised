        "candidate_streams": {
          "1": [
            {"id": "near-fighter", "category": "Fighter", "priority": 3, "position": [100, 0, 0]},
            {"id": "far-bomber", "category": "Bomber", "priority": 2, "position": [600, 0, 0]}
          ]
        }
      },
      "commands": [],
      "ticks": [
        {"frame": 16, "action": "service_weapon_once"}
