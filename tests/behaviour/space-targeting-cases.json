{
  "schema_version": 1,
  "contract": "docs/behaviour/space-targeting.md",
  "default_resolution": "recursively overlay case values on defaults; arrays replace",
  "fixture_semantics": {
    "normative_outputs": ["expected_events", "expected_final_target", "expected_last_scan_frame", "expected_player_start_draw_count"],
    "expected_trace": "review narration only; not a required runtime output or ordered diagnostic schema",
    "player_start_index": "injected result available when the synchronized player-start draw is consumed, not an RNG seed; parent global opportunity suppression or active stealth consumes zero draws",
    "expected_player_start_draw_count": "normative count across all listed ticks; zero before a scan or when parent suppression returns before the draw, otherwise one per scan attempt",
    "candidate_stream_keys": "decimal labels for numeric player indices; each array is already in authoritative candidate order",
    "retained_target_attempt": "injected result of the immediate attempt against the retained object; independent of candidate_defaults.fire_attempt_succeeds",
    "command_timing": "apply commands whose after_frame equals a completed tick after that tick and before the next tick"
  },
  "units": {
    "position": "source_distance_units_xyz",
    "distance": "source_distance_units_3d",
    "frame": "logical_frame",
    "priority": "lower_numeric_value_is_better"
  },
  "defaults": {
    "weapon": {
      "content_unit": "TIE_Defender",
      "content_hardpoint": "HP_TIE_DEFENDER_ION_00",
      "range": 700,
      "opportunity_when_idle": true,
      "opportunity_when_targeting": true,
      "requires_manual_target": false,
      "is_turret": false
    },
    "service_gates": "admitted",
    "primary_or_manual_fired": false,
    "shooter_position": [0, 0, 0],
    "shooter_in_nebula": false,
    "shooter_stealth_active": false,
    "opportunity_fire_disabled": false,
    "logical_fps": 30,
    "last_scan_frame": 0,
    "player_start_index": 1,
    "players": [
      {"index": 0, "relation": "owner"},
      {"index": 1, "relation": "enemy", "can_see_shooter_in_nebula": true}
    ],
    "candidate_defaults": {
      "model_present": true,
      "valid_target_type": true,
      "in_limbo": false,
      "dead": false,
      "stealth_hidden": false,
      "shooter_can_target_stealth": false,
      "marker_object": false,
      "hero_clash_compatible": true,
      "in_transport": false,
      "fogged_to_shooter_owner": false,
      "projectile_collidable": true,
      "weapon_category_restricted": false,
      "opportunity_fire_disabled_on_candidate": false,
      "aim_point_mode": "fallback",
      "soft_radius": 0,
      "can_point": true,
      "fire_attempt_succeeds": true
    }
  },
