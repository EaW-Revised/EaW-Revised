[configuration]

entry_symbol = "eawr_fog_probe_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://bin/libeawr_fog_probe.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://bin/libeawr_fog_probe.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libeawr_fog_probe.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://bin/libeawr_fog_probe.linux.template_release.x86_64.so"
