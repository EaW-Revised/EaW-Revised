; Isolated synthetic fog-stub-v1 production renderer probe; not the viewer project.
config_version=5

[application]
config/name="EAWR Fog Renderer Probe"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=400
window/size/viewport_height=200

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver.windows="vulkan"
