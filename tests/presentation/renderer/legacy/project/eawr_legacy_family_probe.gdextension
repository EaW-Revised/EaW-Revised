[configuration]

entry_symbol = "eawr_legacy_family_probe_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://bin/libeawr_legacy_family_probe.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://bin/libeawr_legacy_family_probe.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libeawr_legacy_family_probe.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://bin/libeawr_legacy_family_probe.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libeawr_legacy_family_probe.linux.template_release.arm64.so"
linux.release.arm64 = "res://bin/libeawr_legacy_family_probe.linux.template_release.arm64.so"
